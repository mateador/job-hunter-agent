# Copy this file to .env and fill in your real OpenAI API key.
# Never commit .env to GitHub.

# Your OpenAI secret API key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Recommended development model
OPENAI_MODEL=gpt-4o-mini

# FreeHire API configuration
# We are using the dedicated /agent/ endpoint for full descriptions!
FREEHIRE_SEARCH_URL=https://freehire.me/api/v1/agent/jobs/search

# The query parameter for keywords is 'q'
FREEHIRE_QUERY_PARAM=q

# We force Markdown format for the LLM
FREEHIRE_DESCRIPTION_FORMAT=markdown

# Pagination and limits
FREEHIRE_LIMIT_PARAM=limit
FREEHIRE_DEFAULT_LIMIT=5
