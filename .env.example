# Copy this file to .env and fill in your real OpenAI API key.
# Never commit .env to GitHub.

# Your OpenAI secret API key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model used by the key check (python -m src.job_agent.check_openai). The agent itself
# takes its model from --model (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# FreeHire API configuration
# We are using the dedicated /agent/ endpoint for full descriptions!
FREEHIRE_SEARCH_URL=https://freehire.me/api/v1/agent/jobs/search

# The query parameter for keywords is 'q'
FREEHIRE_QUERY_PARAM=q

# We force Markdown format for the LLM
FREEHIRE_DESCRIPTION_FORMAT=markdown

# Pagination and limits
FREEHIRE_LIMIT_PARAM=limit

# Region filter. Only "uk" is verified; FreeHire may ignore other values (see search_meta in the trace)
FREEHIRE_REGIONS=uk

# Optional facts about you that are not in the CV (location, work authorisation). They are passed to
# the model and stay out of the code. Same as --candidate-note.
# CANDIDATE_NOTE=Based in London; no visa sponsorship required.

# Per-attempt LLM timeout in seconds (default 60). Reasoning models (gpt-5 family) can need 120-180.
# LLM_TIMEOUT=60
